OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
APP_ENV=
LOG_LEVEL=

# Caché exact-match compartida entre FastAPI y Streamlit
REDIS_URL=redis://localhost:6379
CACHE_TTL=86400
CACHE_ENABLED=true

# Ventana de conversación: pares user+assistant retenidos por sesión
SESSION_MAX_TURNS=6

# URL base del servicio que consume el formulario Streamlit
ESTIMATION_API_URL=http://localhost:8000
